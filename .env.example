# Database (local PostgreSQL)
# Replace USER, PASSWORD, and DB name with your own values:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/fire_extinguisher_db?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-refresh-secret-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Default admin account (created automatically on startup)
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="System Admin"

# SMTP (for OTP and notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
# Gmail app passwords are 16 characters with no spaces
SMTP_PASS="your-app-password"
SMTP_FROM="Fire Extinguisher System <your-email@gmail.com>"

# Service URLs (used by gateway)
AUTH_SERVICE_URL="http://localhost:3001"
USER_SERVICE_URL="http://localhost:3002"
EXTINGUISHER_SERVICE_URL="http://localhost:3003"
INSPECTION_SERVICE_URL="http://localhost:3004"
MAINTENANCE_SERVICE_URL="http://localhost:3005"
REPORTING_SERVICE_URL="http://localhost:3006"
NOTIFICATION_SERVICE_URL="http://localhost:3007"

# Service ports
GATEWAY_PORT=3000
AUTH_PORT=3001
USER_PORT=3002
EXTINGUISHER_PORT=3003
INSPECTION_PORT=3004
MAINTENANCE_PORT=3005
REPORTING_PORT=3006
NOTIFICATION_PORT=3007

# Frontend
VITE_API_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# Notification settings
EXPIRY_WARNING_DAYS=30
RESPONSE_DEADLINE_DAYS=7
