    "migrate": "dotenv -e ../.env -- prisma migrate dev",
    "seed": "dotenv -e ../.env -- node seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^5.22.0"
  }
}
